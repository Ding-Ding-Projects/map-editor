{
  "info": {
    "name": "Map Editor API",
    "description": "Every HTTP route the Map Editor server answers, grouped by area. Sign in first (POST /api/auth/login) so the session cookie is kept; state-changing requests must send JSON. Set baseUrl to your server, for example http://localhost:8420.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8420"
    }
  ],
  "item": [
    {
      "name": "Sign-in and accounts",
      "item": [
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex\",\n  \"password\": \"correct horse battery\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Reads: name, password, code. Values in angle brackets come from an earlier request."
          }
        },
